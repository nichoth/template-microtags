{
  "name": "{{package-name}}",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "main": "dist/index.js",
  "files": [
    "./dist/*"
  ],
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "test:browser": "node -e \"if(!require('./package.json').name.includes('{'))process.exit(1)\" || esbuild ./test/index.ts --bundle | tapout",
    "test:ssr": "npx esbuild ./test/ssr.ts --bundle --format=cjs --platform=node --loader:.css=empty | node -",
    "test": "npm run test:ssr && npm run test:browser",
    "build-css": "lightningcss --nesting src/index.css -o dist/index.css",
    "build-css:min": "lightningcss --nesting --minify src/index.css -o dist/index.min.css",
    "build-cjs": "esbuild src/*.ts --format=cjs --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.cjs --sourcemap",
    "build-esm": "esbuild src/*.ts --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist",
    "build-esm:min": "esbuild ./src/*.ts --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension:.js=.min.js --outdir=./dist --sourcemap",
    "build-example": "mkdir -p ./public && rm -rf ./public/* && NODE_ENV=development vite --mode staging --base=\"/{{repo-name}}\" build",
    "build": "mkdir -p ./dist && rm -rf ./dist/* && npm run build-cjs && npm run build-esm && npm run build-esm:min && npm run build-css && npm run build-css:min",
    "build-cli": "esbuild ./bin/cli.ts > ./bin/cli.js",
    "start": "vite",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "stylelint": "stylelint \"**/*.css\" --ignore-pattern \"public/**\"",
    "preversion": "npm run lint && stylelint src/*.css",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/index.css",
    "./min/css": "./dist/index.min.css",
    "./min/*": {
      "import": "./dist/*.min.js",
      "require": "./dist/*.min.cjs"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "dependencies": {
    "microtags": "^0.1.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.3.0",
    "@substrate-system/debug": "^0.9.60",
    "@substrate-system/dom": "^0.1.18",
    "@substrate-system/redeye": "^0.1.8",
    "@substrate-system/tapout": "^0.1.1",
    "@substrate-system/tapzero": "^0.10.16",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "auto-changelog": "^2.4.0",
    "browserslist": "^4.28.1",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "globby": "^16.1.0",
    "handlebars": "^4.7.8",
    "lightningcss": "^1.30.2",
    "lightningcss-cli": "^1.30.2",
    "markdown-toc": "^1.2.0",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "tap-spec": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.5",
    "yargs": "^18.0.0"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)",
  "license": "SEE LICENSE IN LICENSE",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild": true,
    "lightningcss-cli": true
  }
}
